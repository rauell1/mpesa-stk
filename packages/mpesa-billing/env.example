# Database (PostgresStore) — a role that can create and write the billing tables.
DATABASE_URL=postgres://user:pass@host/db

# --- M-PESA / Daraja --------------------------------------------------------
MPESA_ENVIRONMENT=sandbox              # sandbox | live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # 174379 is the Daraja sandbox paybill
MPESA_PASSKEY=
# Public HTTPS origin of your app. Safaricom will not call http:// or
# localhost — tunnel it (ngrok/cloudflared) in development.
MPESA_CALLBACK_BASE_URL=https://app.example.com
MPESA_TIMEOUT_MS=30000

# Payouts (B2C and B2B) only. The certificate is Safaricom's public cert for
# the environment — sandbox and production ship different files.
#
# Literal \n escapes are fine: only dotenv expands them, and Docker, Kubernetes,
# Vercel, and GitHub Actions all hand over the two characters instead. The
# package repairs either form, so the same value works everywhere.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_SECURITY_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# B2B only, and not read from the environment — the shortcode you are paying is
# a per-payment argument (`receiverShortCode`), not configuration.

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. Without it every webhook is rejected.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
