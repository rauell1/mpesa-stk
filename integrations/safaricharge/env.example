# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Must be a role that BYPASSES RLS — the webhook handlers write payment rows
# with no authenticated user for the policies to resolve against.
BILLING_DATABASE_URL=postgres://user:pass@host/db

# ---------------------------------------------------------------------------
# M-PESA / Daraja
# ---------------------------------------------------------------------------
MPESA_ENVIRONMENT=sandbox              # sandbox | live
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379                 # 174379 is the Daraja sandbox paybill
MPESA_PASSKEY=
# Public HTTPS origin of this app. Safaricom will not call an http:// or
# localhost URL — tunnel it (ngrok/cloudflared) in development.
MPESA_CALLBACK_BASE_URL=https://app.example.com
MPESA_TIMEOUT_MS=30000

# B2C (payouts) only. The certificate is Safaricom's public cert for the
# environment — sandbox and production certs are different files.
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_SECURITY_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. Without it the webhook route rejects every request.
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=https://app.example.com
